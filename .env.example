# ==============================================================================
# FERRYMARKET - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================
# Salin file ini menjadi:
#   - backend/.env  (untuk variabel backend)
#   - frontend/.env (untuk variabel VITE_* frontend)
# JANGAN PERNAH menyimpan secret asli atau service_role key ke Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER & APPLICATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
APP_NAME=FerryMarket
APP_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:5173

# ------------------------------------------------------------------------------
# DATABASE (SUPABASE POSTGRESQL + PRISMA)
# ------------------------------------------------------------------------------
# Gunakan Transaction Pooler (port 6543) untuk DATABASE_URL & Session/Direct (5432) untuk DIRECT_URL
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_DB_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# SUPABASE STORAGE (BACKEND ONLY - JANGAN EKSPOS SERVICE_ROLE KE FRONTEND)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=ferrymarket-media
# Opsional: bucket privat khusus bukti pembayaran
SUPABASE_PAYMENT_PROOF_BUCKET=ferrymarket-payment-proofs

# ------------------------------------------------------------------------------
# AUTHENTICATION & SECURITY (JWT)
# ------------------------------------------------------------------------------
# Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_strong_random_secret_min_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_strong_random_secret_min_64_chars
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# WHATSAPP NOTIFICATION API (BACKEND ONLY - OPSIONAL)
# ------------------------------------------------------------------------------
# Provider yang didukung: "meta" (WhatsApp Cloud API), "fonnte", "wablas", atau "custom"
WHATSAPP_PROVIDER=meta
WHATSAPP_API_URL=https://graph.facebook.com/v20.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Nomor default admin untuk menerima notifikasi transaksi (format internasional tanpa +, misal 6281234567890)
WHATSAPP_ADMIN_PHONE=

# ------------------------------------------------------------------------------
# TELEGRAM BOT API (BACKEND ONLY - OPSIONAL)
# ------------------------------------------------------------------------------
# Buat bot melalui @BotFather di Telegram untuk mendapatkan token
TELEGRAM_BOT_TOKEN=
# Chat ID admin / grup notifikasi admin (dapatkan via @userinfobot atau getUpdates)
TELEGRAM_ADMIN_CHAT_ID=

# ------------------------------------------------------------------------------
# EMAIL / RESET PASSWORD (OPSIONAL - LOG DI CONSOLE PADA MODE DEV)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FerryMarket <no-reply@ferrymarket.local>"

# ------------------------------------------------------------------------------
# FRONTEND (SALIN KE frontend/.env - HANYA VARIABEL PUBLIK VITE_*)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
VITE_APP_URL=http://localhost:5173
VITE_APP_NAME=FerryMarket
